```{=html}
<div class="alumni">
  <div class="alumni-head"><span>Name</span><span>Years</span><span>Now</span></div>
<% for (const item of items) { %>
  <div class="alumnus" <%= metadataAttrs(item) %>>
    <span class="alumnus-name"><a href="<%= item.path %>"><%- item.title %></a></span>
    <span class="alumnus-years"><%- item.years || '' %></span>
    <span class="alumnus-now"><%- item.now || '' %></span>
  </div>
<% } %>
</div>
```
