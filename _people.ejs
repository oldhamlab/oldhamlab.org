```{=html}
<ul class="roster<%= templateParams.bio ? '' : ' roster--compact' %>">
<% for (const item of items) { %>
  <li class="person" <%= metadataAttrs(item) %>>
    <% if (item.image) { %>
      <span class="portrait"><img src="<%= item.image %>" alt="" loading="lazy"></span>
    <% } %>
    <div class="person-body">
      <% if (item.subtitle) { %><span class="person-role"><%- item.subtitle %></span><% } %>
      <h3 class="person-name"><a href="<%= item.path %>"><%- item.title %></a></h3>
      <% if (templateParams.bio && item.description) { %>
        <p class="person-bio"><%= item.description %></p>
      <% } %>
    </div>
  </li>
<% } %>
</ul>
```
